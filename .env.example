# LLM Provider Configuration
# Supported providers: openai, anthropic (Claude), gemini, or any OpenAI-compatible endpoint
LLM_PROVIDER=openai

# API Keys for different LLM providers (only set the ones you use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (provider-specific model names)
# OpenAI examples: gpt-4.1-mini, gpt-5-nano, gpt-4o-mini
# Claude examples: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Gemini examples: gemini/gemini-2.0-flash-exp, gemini/gemini-1.5-pro
TRANSLATION_MODEL=gpt-4.1-mini
SUMMARY_MODEL=gpt-5-nano

# Language Configuration
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=tr

# ElevenLabs API Key (for text-to-speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here